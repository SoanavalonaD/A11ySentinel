# Copy to .env and fill in. .env is gitignored — never commit real values.

GOOGLE_CLOUD_PROJECT=a11ysentinel-xxxxx
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Vertex AI.
# The Gemini 3.x family is served from the `global` endpoint, not from
# regional ones — a 3.x model id returns NOT_FOUND against us-central1.
# VERTEX_LOCATION is therefore separate from GOOGLE_CLOUD_LOCATION above,
# which is where Firestore, Cloud Run and the bucket live.
GEMINI_MODEL=gemini-3.7-flash
VERTEX_LOCATION=global

# Storage
ARTIFACTS_BUCKET=a11ysentinel-artifacts

# Firestore
FIRESTORE_DATABASE=(default)

# Audit limits — cost control. Playwright in Cloud Run Jobs is the cost driver.
MAX_PAGES_PER_AUDIT=5
PAGE_TIMEOUT_MS=30000

# Findings below this confidence are discarded before write (contract invariant 4)
MIN_CONFIDENCE=0.7
